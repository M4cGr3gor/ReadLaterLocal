{
  "name": "read-later-local",
  "version": "1.10.2",
  "private": true,
  "description": "Firefox read-it-later extension that keeps everything local: no account, no server",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "lint": "web-ext lint --source-dir src",
    "start": "web-ext run --source-dir src --browser-console",
    "build": "web-ext build --source-dir src --artifacts-dir dist --overwrite-dest"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "fake-indexeddb": "^6.0.0",
    "linkedom": "^0.18.15",
    "web-ext": "^8.0.0"
  }
}
